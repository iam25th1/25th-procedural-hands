{
  "name": "25th-procedural-hands",
  "version": "0.1.0",
  "description": "Procedural hand and arm rig for three.js: 25 WebXR joints per hand, per-finger control, IK, grasping, gestures and a deterministic interaction layer, every value from a published measurement",
  "keywords": [
    "three",
    "threejs",
    "hands",
    "hand",
    "rig",
    "procedural",
    "animation",
    "ik",
    "inverse-kinematics",
    "grasp",
    "webxr",
    "skinned-mesh",
    "anatomy"
  ],
  "license": "MIT",
  "author": "25TH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iam25th1/25th-procedural-hands.git"
  },
  "homepage": "https://github.com/iam25th1/25th-procedural-hands#readme",
  "bugs": {
    "url": "https://github.com/iam25th1/25th-procedural-hands/issues"
  },
  "type": "module",
  "exports": {
    ".": "./hands/src/index.js",
    "./package.json": "./package.json"
  },
  "main": "./hands/src/index.js",
  "files": [
    "hands/src/",
    "hands/README.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "hands:check": "node scripts/hands-check.js",
    "hands:matrix": "node scripts/hands-matrix.js",
    "hands:plans": "node scripts/hands-plans.js",
    "hands:gallery": "node scripts/hands-gallery.js",
    "gate": "npm run check && npm test && npm run hands:check && npm run hands:matrix && npm audit --audit-level=high",
    "sandbox": "node server/index.js",
    "example": "npm --prefix examples/consumer run dev"
  },
  "peerDependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@fontsource/alfa-slab-one": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "animejs": "4.5.0",
    "playwright": "1.63.0",
    "three": "0.186.0"
  }
}
